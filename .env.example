# ============================================================
# ARCHIVO DE EJEMPLO - NO coloques credenciales reales aqui
# Copia este archivo como .env y completa con valores del ambiente
# ============================================================

# Zona horaria del proceso Node.js
TZ=America/Argentina/Buenos_Aires

# Base de datos PostgreSQL
DATABASE_URL=postgresql://local_dev_user:local_dev_password_change_me@127.0.0.1:5432/consignacion_app_dev

# Auth y firmas - genera secretos aleatorios antes de usar fuera de local
JWT_SECRET="dev-only-jwt-secret-change-me-before-shared-64chars-minimum-0001"
JWT_COOKIE_NAME="dev_only_access_token_change_me"
SHARE_LINK_SECRET="dev-only-share-link-secret-change-me-before-shared-0001"
PDF_SECRET="dev-only-pdf-secret-change-me-before-shared-0001"
CRON_SECRET="dev-only-cron-secret-change-me-before-shared-0001"
SOCKET_DISPATCH_SECRET="dev-only-socket-dispatch-secret-change-me-before-shared-0001"

# Rate limiting auth/recovery - ajustar por entorno si hace falta
AUTH_RATE_LIMIT_LOGIN_IP_MAX=20
AUTH_RATE_LIMIT_LOGIN_IP_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_IDENTITY_MAX=5
AUTH_RATE_LIMIT_LOGIN_IDENTITY_WINDOW_MS=900000
AUTH_RATE_LIMIT_FORGOT_IP_MAX=10
AUTH_RATE_LIMIT_FORGOT_IP_WINDOW_MS=900000
AUTH_RATE_LIMIT_FORGOT_IDENTITY_MAX=3
AUTH_RATE_LIMIT_FORGOT_IDENTITY_WINDOW_MS=1800000
AUTH_RATE_LIMIT_RESET_IP_MAX=10
AUTH_RATE_LIMIT_RESET_IP_WINDOW_MS=900000
AUTH_RATE_LIMIT_RESET_TOKEN_MAX=5
AUTH_RATE_LIMIT_RESET_TOKEN_WINDOW_MS=1800000
AUTH_RATE_LIMIT_RESET_IP_TOKEN_MAX=3
AUTH_RATE_LIMIT_RESET_IP_TOKEN_WINDOW_MS=1800000

# URLs de aplicacion
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Credenciales iniciales de seed - solo para bootstrap local
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe-LocalOnly-Admin-123!"
AGUSTIN_EMAIL="usuario-local@example.com"
AGUSTIN_PASSWORD="ChangeMe-LocalOnly-User-123!"

# Mercado Pago (usar credenciales de sandbox o placeholders no productivos)
MP_ACCESS_TOKEN=local-dev-mp-access-token-change-me
MP_PUBLIC_KEY=local-dev-mp-public-key-change-me
NEXT_PUBLIC_MP_PUBLIC_KEY=local-dev-mp-public-key-change-me
MP_WEBHOOK_SECRET=local-dev-mp-webhook-secret-change-me

# PayPal (usar sandbox salvo despliegue controlado)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=local-dev-paypal-client-id-change-me
PAYPAL_SECRET=local-dev-paypal-secret-change-me
PAYPAL_WEBHOOK_ID=local-dev-paypal-webhook-id-change-me
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Negocio y feature flags
DEFAULT_TRIAL_DAYS=7
PUBLIC_CHECKOUT_V2=false

# Email transaccional
RESEND_API_KEY=local-dev-resend-api-key-change-me

# Uploads - opcional; si no se define se usa public/uploads en local
# UPLOAD_DIR=C:/consignacion-app/uploads

# Facturas de proveedor (OCR): subcarpeta "facturas-proveedor" dentro de UPLOAD_DIR
# si está definido, o storage/facturas-proveedor en local. A diferencia de las
# imágenes de producto, NUNCA se sirven desde public/ (documentos sensibles).

# OCR de facturas de proveedor vía Modal.com (worker externo, sin acceso a la DB).
# MODAL_OCR_ENDPOINT_URL es la URL BASE del server (sin /v1/chat/completions, el
# cliente lo agrega solo).
MODAL_OCR_ENDPOINT_URL=https://tu-workspace--tu-app.modal.run
# Par de Proxy Auth de Modal (Settings > Proxy Auth Tokens, o `modal token new`).
# Van en headers Modal-Key / Modal-Secret — NO es un Bearer token de aplicación.
MODAL_PROXY_KEY=local-dev-modal-proxy-key-change-me
MODAL_PROXY_SECRET=local-dev-modal-proxy-secret-change-me
MODAL_MODEL_NAME=Qwen/Qwen3.6-35B-A3B
# Secreto propio (no reutilizar SHARE_LINK_SECRET/PDF_SECRET) para firmar accesos
# de corta duración al archivo original de la factura (endpoint /archivo).
OCR_CALLBACK_SECRET=local-dev-ocr-callback-secret-change-me
OCR_TIMEOUT_MS=45000
OCR_MAX_TOKENS=4096
# El contenedor de Modal escala a 0 cuando está inactivo; el primer request tras
# un rato sin uso puede tardar 1-3 minutos en levantar (503 mientras arranca).
# Estos controlan cuánto se reintenta antes de darse por vencido.
OCR_COLD_START_MAX_RETRIES=8
OCR_COLD_START_RETRY_DELAY_MS=15000

# Subscription plans
NEXT_PUBLIC_PLAN_1_NOMBRE="Basico"
NEXT_PUBLIC_PLAN_1_PRICE_ARS=60000
NEXT_PUBLIC_PLAN_1_PRICE_USD=42
NEXT_PUBLIC_MP_PLAN_BASICO="local-dev-mp-plan-basico"
NEXT_PUBLIC_PAYPAL_PLAN_BASICO="local-dev-paypal-plan-basico"
PLAN_1_MAX_PRODUCTOS=45
PLAN_1_MAX_USUARIOS=5
PLAN_1_ALLOW_CONSIGNACIONES=false
PLAN_1_ALLOW_SUCURSALES=false

NEXT_PUBLIC_PLAN_2_NOMBRE="Pro"
NEXT_PUBLIC_PLAN_2_PRICE_ARS=80000
NEXT_PUBLIC_PLAN_2_PRICE_USD=60
NEXT_PUBLIC_MP_PLAN_PRO="local-dev-mp-plan-pro"
NEXT_PUBLIC_PAYPAL_PLAN_PRO="local-dev-paypal-plan-pro"
PLAN_2_MAX_PRODUCTOS=-1
PLAN_2_MAX_USUARIOS=15
PLAN_2_ALLOW_CONSIGNACIONES=true
PLAN_2_ALLOW_SUCURSALES=false

NEXT_PUBLIC_PLAN_3_NOMBRE="Enterprise"
NEXT_PUBLIC_PLAN_3_PRICE_ARS=150000
NEXT_PUBLIC_PLAN_3_PRICE_USD=115
NEXT_PUBLIC_MP_PLAN_ENTERPRISE="local-dev-mp-plan-enterprise"
NEXT_PUBLIC_PAYPAL_PLAN_ENTERPRISE="local-dev-paypal-plan-enterprise"
PLAN_3_MAX_PRODUCTOS=-1
PLAN_3_MAX_USUARIOS=100
PLAN_3_ALLOW_CONSIGNACIONES=true
PLAN_3_ALLOW_SUCURSALES=true
