generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  EMPLEADO
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
}

enum MotivoMovimientoStock {
  COMPRA // Entrada por compra a proveedor
  DEVOLUCION_CLIENTE // Entrada por devolución
  AJUSTE_POSITIVO // Entrada manual por corrección
  ROTURA // Salida por producto dañado
  VENCIMIENTO // Salida por producto vencido
  PERDIDA // Salida por pérdida/robo
  AJUSTE_NEGATIVO // Salida manual por corrección
  VENTA // Salida automática por venta (opcional)
  CONSIGNACION // Movimiento por consignación (opcional)
}

enum ShareLinkType {
  TICKET
  REMITO
  INVENTARIO
  HISTORIAL_INVENTARIO
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRATION_NEAR
  PRODUCT_EXPIRED
  SYSTEM
}

enum EstadoConsignacion {
  ABIERTA
  CERRADA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

model Configuracion {
  id             Int @id @default(1) // Siempre será ID 1
  minStockGlobal Int @default(5) // El admin puede cambiar esto desde el panel
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String
  email     String     @unique
  hash      String
  rol       RolUsuario @default(EMPLEADO)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@index([rol])
}

model Cliente {
  id        Int     @id @default(autoincrement())
  nombre    String
  telefono  String?
  direccion String?
  activo    Boolean @default(true)

  /// saldo positivo = debe
  saldoCuenta Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  consignaciones Consignacion[]
  pagos          Pago[]
  ventas         Venta[]
}

model MovimientoStock {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  tipo     TipoMovimientoStock
  motivo   MotivoMovimientoStock
  cantidad Int

  // Guardamos una foto de cómo estaba el stock antes y después para auditoría
  stockPrevio    Int
  stockPosterior Int

  observaciones String? // Nota manual opcional

  createdAt DateTime @default(now())

  @@index([productoId])
  @@index([createdAt])
}

model Notification {
  id Int @id @default(autoincrement())

  type        NotificationType
  title       String
  description String

  // Relación con Producto (Opcional, por si se borra el producto físico)
  productoId Int?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  // Estado
  read Boolean @default(false)

  fingerprint String @unique

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // <--- AGREGADO: Vital para ordenar por "actividad reciente"
  readAt    DateTime?

  // Índices optimizados para tus queries del panel
  @@index([read, updatedAt]) // Para: "Dame las no leídas más recientes"
  @@index([type, createdAt]) // Para filtros por tipo
  @@index([productoId]) // Para ver historial de un producto
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String? // Opcional, para detalles extra
  codigoBarra String? @unique
  sku         String? @unique
  activo      Boolean @default(true)

  precioVenta Decimal @db.Decimal(10, 2)
  precioCosto Decimal @db.Decimal(10, 2)
  iva         Decimal @default(21.0) @db.Decimal(5, 2)

  stockDisponibleUnits Int @default(0)
  stockConsignadoUnits Int @default(0)
  stockMinUnits        Int @default(0)

  packSizeUnits    Int? // Ej: 12 si es un pack
  fechaVencimiento DateTime?

  // Relaciones
  categoriaId Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consignacionDetalles ConsignacionDetalle[]
  ventaDetalles        VentaDetalle[]
  notifications        Notification[]
  movimientoStocks     MovimientoStock[]

  @@index([codigoBarra])
  @@index([categoriaId])
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model ShareLink {
  id Int @id @default(autoincrement())

  // Lookup seguro (no reversible)
  codeHash String @unique

  // Reutilización: guardamos el code cifrado (reversible con secret)
  codeEnc String

  type     ShareLinkType
  targetId Int

  expiresAt DateTime
  maxViews  Int      @default(3)
  views     Int      @default(0)

  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?

  @@index([type, targetId, expiresAt])
}

model Consignacion {
  id Int @id @default(autoincrement())

  /// Folio secuencial por cliente (ej: Pedro #1, Pedro #2)
  numeroFolio       Int
  porcentajeAumento Float @default(0)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  fecha  DateTime           @default(now())
  estado EstadoConsignacion @default(ABIERTA)

  detalles      ConsignacionDetalle[]
  liquidaciones Liquidacion[]

  @@index([clienteId, fecha])
  @@index([estado, fecha])
  // Indexamos el folio para búsquedas rápidas si fuera necesario
  @@index([clienteId, numeroFolio])
}

model ConsignacionDetalle {
  id             Int          @id @default(autoincrement())
  consignacionId Int
  consignacion   Consignacion @relation(fields: [consignacionId], references: [id], onDelete: Cascade)

  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  precioUnitario Decimal  @default(0) @db.Decimal(10, 2)

  /// TODO EN UNITS
  unitsEntregadas    Int
  unitsVendidasAcum  Int @default(0)
  unitsDevueltasAcum Int @default(0)

  /// Relación inversa requerida por LiquidacionItem.detalle
  liquidacionItems LiquidacionItem[]

  @@index([consignacionId])
  @@index([productoId])
}

model Liquidacion {
  id             Int          @id @default(autoincrement())
  consignacionId Int
  consignacion   Consignacion @relation(fields: [consignacionId], references: [id], onDelete: Cascade)

  fecha DateTime @default(now())

  items LiquidacionItem[]
  venta Venta? // venta opcional asociada (si hubo unitsVendidas)

  @@index([consignacionId, fecha])
}

model LiquidacionItem {
  id            Int         @id @default(autoincrement())
  liquidacionId Int
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  consignacionDetalleId Int
  detalle               ConsignacionDetalle @relation(fields: [consignacionDetalleId], references: [id], onDelete: Restrict)

  /// TODO EN UNITS
  unitsVendidas  Int @default(0)
  unitsDevueltas Int @default(0)

  /// snapshot del precio al liquidar
  precioUnitario Decimal @db.Decimal(10, 2)

  @@index([liquidacionId])
  @@index([consignacionDetalleId])
}

model Venta {
  id        Int     @id @default(autoincrement())
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  /// 1 venta opcional asociada a 1 liquidación
  liquidacionId Int?         @unique
  liquidacion   Liquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  fecha DateTime @default(now())
  total Decimal  @db.Decimal(10, 2)

  detalles VentaDetalle[]

  @@index([clienteId, fecha])
}

model VentaDetalle {
  id      Int   @id @default(autoincrement())
  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  /// TODO EN UNITS
  units Int

  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  @@index([ventaId])
  @@index([productoId])
}

model Pago {
  id        Int     @id @default(autoincrement())
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  fecha  DateTime   @default(now())
  monto  Decimal    @db.Decimal(10, 2)
  metodo MetodoPago

  @@index([clienteId, fecha])
}
