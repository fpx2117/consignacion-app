generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Configuracion {
  id                             Int      @id @default(autoincrement())
  minStockGlobal                 Int      @default(5)
  diasAnticipacionVencimiento    Int      @default(7)
  notificarStockBajo             Boolean  @default(true)
  notificarVencimientos          Boolean  @default(true)
  notificarVentas                Boolean  @default(true)
  usarControlDeCaja              Boolean  @default(true)
  diasAvisoConsignacion          Int      @default(15)
  notificarConsignacionesActivas Boolean  @default(true)
  notificarLiquidaciones         Boolean  @default(true)
  mensajeWhatsappConsignacion    String?
  mensajeWhatsappVenta           String?
  sucursalId                     Int      @unique @default(1)
  porcentajeAumentoConsignacion  Float    @default(0)
  mostrarPreciosConsignacion     Boolean  @default(false)
  porcentajeInteresTarjeta       Float    @default(0)
  convertirTienda                Boolean  @default(false)
  tiendaMetodoPago               String   @default("whatsapp")
  mostrarListaPrecios            Boolean  @default(false)
  mpAccessTokenTienda            String?
  mpPublicKeyTienda              String?
  separarListaPorSucursal        Boolean  @default(true)
  mostrarEnTiendaOnline          Boolean  @default(false)
  tiendaSlug                     String?  @unique
  mostrarCategoriasEnHeader      Boolean  @default(true)
  tiendaLayout                   String   @default("grid")
  andreaniContratoDomicilio      String?
  andreaniContratoSucursal       String?
  andreaniCliente                String?
  andreaniUsuario                String?
  andreaniPassword               String?
  zonaHoraria                    String   @default("America/Argentina/Buenos_Aires")
  timezoneMigrationDone          Boolean  @default(false)
  // Rubro del negocio (ver src/modules/invoices/config/rubros.ts): slug fijo o
  // texto libre si el usuario eligió "otro". Se usa únicamente como contexto
  // para el prompt de extracción de facturas por IA — no cambia el pipeline.
  rubroNegocio                   String?
  // Claves de Producto.atributosExtra que el usuario eligió mostrar como
  // columna en la tabla de productos (selector manual, ver productos-view.tsx).
  columnasAtributosProducto      String[] @default([])
  sucursal                       Sucursal @relation(fields: [sucursalId], references: [id])
}

// Configuración global de la tienda online, única fila (id=1) para todo el negocio.
// Decide si las sucursales que optaron in (Configuracion.mostrarEnTiendaOnline)
// comparten un solo catálogo combinado (/lista) o cada una tiene su propia URL
// por slug (/[slug]).
model TiendaGlobalConfig {
  id            Int      @id @default(autoincrement())
  modoUnificado Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Usuario {
  id            Int              @id @default(autoincrement())
  nombre        String
  email         String           @unique
  hash          String
  rol           RolUsuario       @default(EMPLEADO)
  activo        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sucursalId    Int?
  zonaHoraria   String?
  auditLogs     AuditLog[]
  horarios      HorarioLaboral[]
  notifications Notification[]
  sesionesCaja  SesionCaja[]
  subscription  Subscription?
  userSessions  UserSession[]
  gastos        Gasto[]
  sucursal      Sucursal?        @relation(fields: [sucursalId], references: [id])

  @@index([rol])
  @@index([sucursalId])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       Int
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  browser      String?
  os           String?
  device       String?
  city         String?
  country      String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  module    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      Usuario? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

model HorarioLaboral {
  id         Int     @id @default(autoincrement())
  usuarioId  Int
  diaSemana  Int
  horaInicio String
  horaFin    String
  activo     Boolean @default(true)
  usuario    Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, diaSemana])
}

model Cliente {
  id             Int            @id @default(autoincrement())
  nombre         String
  email          String?
  documento      String?
  telefono       String?
  direccion      String?
  provincia      String?
  localidad      String?
  codigoPostal   String?
  activo         Boolean        @default(true)
  /// saldo positivo = debe
  saldoCuenta    Decimal        @default(0) @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  sucursalId     Int            @default(1)
  sucursal       Sucursal       @relation(fields: [sucursalId], references: [id])
  consignaciones Consignacion[]
  pagos          Pago[]
  ventas         Venta[]

  @@index([sucursalId])
}

model Branding {
  id                Int              @id @default(autoincrement())
  businessName      String
  primaryColor      String           @default("#111827")
  footerText        String?
  phone             String?
  address           String?
  updatedAt         DateTime         @updatedAt
  logoData          Bytes?
  logoMime          String?
  sucursalId        Int              @unique @default(1)
  bannerData        Bytes?
  bannerMime        String?
  isBannerSlider    Boolean          @default(false)
  facebookUrl       String?
  instagramUrl      String?
  secondaryColor    String           @default("#3b82f6")
  themeIdentifier   String           @default("modern")
  whatsappNumber    String?
  whatsappMessage   String?          @default("Hola, estoy buscando {nombre_producto}")
  storefrontContent Json?
  sucursal          Sucursal         @relation(fields: [sucursalId], references: [id])
  banners           BrandingBanner[]
}

model BrandingBanner {
  id         Int      @id @default(autoincrement())
  brandingId Int
  bannerData Bytes
  bannerMime String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  branding   Branding @relation(fields: [brandingId], references: [id], onDelete: Cascade)

  @@index([brandingId])
  @@index([orden])
}

model MovimientoStock {
  id             Int                   @id @default(autoincrement())
  productoId     Int
  tipo           TipoMovimientoStock
  motivo         MotivoMovimientoStock
  cantidad       Int
  stockPrevio    Int
  stockPosterior Int
  observaciones  String?
  createdAt      DateTime              @default(now())
  sucursalId     Int                   @default(1)
  producto       Producto              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sucursal       Sucursal              @relation(fields: [sucursalId], references: [id])

  @@index([productoId])
  @@index([createdAt])
  @@index([sucursalId])
}

model Notification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  title       String
  description String
  productoId  Int?
  read        Boolean          @default(false)
  fingerprint String           @unique
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  updatedAt   DateTime         @updatedAt
  userId      Int?
  sucursalId  Int              @default(1)
  producto    Producto?        @relation(fields: [productoId], references: [id])
  user        Usuario?         @relation(fields: [userId], references: [id])
  sucursal    Sucursal         @relation(fields: [sucursalId], references: [id])

  @@index([read, updatedAt])
  @@index([type, createdAt])
  @@index([productoId])
  @@index([sucursalId])
}

model Producto {
  id                    Int                      @id @default(autoincrement())
  nombre                String
  precioVenta           Decimal                  @db.Decimal(10, 2)
  precioCosto           Decimal                  @db.Decimal(10, 2)
  stockDisponibleUnits  Int                      @default(0)
  stockConsignadoUnits  Int                      @default(0)
  packSizeUnits         Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  stockMinUnits         Int                      @default(0)
  fechaVencimiento      DateTime?
  activo                Boolean                  @default(true)
  categoriaId           Int?
  codigoBarra           String?
  descripcion           String?
  iva                   Decimal                  @default(21.0) @db.Decimal(5, 2)
  sku                   String?
  sucursalId            Int?                     @default(1)
  imagenUrl             String?
  subcategoriaId        Int?
  descuentoPorcentaje   Decimal?                 @db.Decimal(5, 2)
  descuentoMonto        Decimal?                 @db.Decimal(10, 2)
  tipoDescuento         String                   @default("porcentaje")
  descuentoActivo       Boolean                  @default(false)
  descuentoDesde        DateTime?
  descuentoHasta        DateTime?
  ultimoCostoCompra     Decimal?                 @db.Decimal(12, 4)
  monedaCosto           String                   @default("ARS")
  fechaUltimaCompra     DateTime?
  // Atributos libres (lote, vencimiento, talle, color, etc.) — mismo formato
  // que FacturaProveedorItem.atributosExtra, editable desde el catálogo sin
  // depender de que el producto haya sido creado por OCR.
  atributosExtra        Json?
  subcategoria          Subcategoria?            @relation(fields: [subcategoriaId], references: [id])
  consignacionDetalles  ConsignacionDetalle[]
  movimientoStocks      MovimientoStock[]
  notifications         Notification[]
  categoria             Categoria?               @relation(fields: [categoriaId], references: [id])
  sucursal              Sucursal?                @relation(fields: [sucursalId], references: [id])
  stockSucursals        StockSucursal[]
  ventaDetalles         VentaDetalle[]
  pedidoItems           PedidoEsperadoItem[]
  facturaProveedorItems FacturaProveedorItem[]
  proveedorAlias        ProductoProveedorAlias[]
  historialCostos       HistorialCostoProducto[]

  @@unique([codigoBarra, sucursalId])
  @@unique([sku, sucursalId])
  @@index([codigoBarra])
  @@index([categoriaId])
  @@index([subcategoriaId])
  @@index([sucursalId])
}

model Caja {
  id         Int          @id @default(autoincrement())
  nombre     String       @unique
  activa     Boolean      @default(true)
  sucursalId Int          @default(1)
  sucursal   Sucursal     @relation(fields: [sucursalId], references: [id])
  sesiones   SesionCaja[]

  @@index([sucursalId])
}

model SesionCaja {
  id                 Int              @id @default(autoincrement())
  cajaId             Int
  usuarioId          Int
  estado             EstadoSesionCaja @default(ABIERTA)
  fechaApertura      DateTime         @default(now())
  fechaCierre        DateTime?
  montoInicial       Decimal          @db.Decimal(10, 2)
  montoFinalEsperado Decimal?         @db.Decimal(10, 2)
  montoFinalReal     Decimal?         @db.Decimal(10, 2)
  diferencia         Decimal?         @db.Decimal(10, 2)
  observaciones      String?
  movimientos        MovimientoCaja[]
  pagos              Pago[]
  caja               Caja             @relation(fields: [cajaId], references: [id])
  usuario            Usuario          @relation(fields: [usuarioId], references: [id])
  ventas             Venta[]

  @@index([cajaId, estado])
  @@index([usuarioId, fechaApertura])
}

model MovimientoCaja {
  id           Int                @id @default(autoincrement())
  sesionCajaId Int
  tipo         TipoMovimientoCaja
  monto        Decimal            @db.Decimal(10, 2)
  motivo       String
  fecha        DateTime           @default(now())
  sesionCaja   SesionCaja         @relation(fields: [sesionCajaId], references: [id], onDelete: Cascade)

  @@index([sesionCajaId])
}

model Categoria {
  id            Int            @id @default(autoincrement())
  nombre        String
  color         String         @default("sky")
  descuentos    Json?
  sucursalId    Int            @default(1)
  sucursal      Sucursal       @relation(fields: [sucursalId], references: [id])
  subcategorias Subcategoria[]
  productos     Producto[]

  @@unique([nombre, sucursalId])
  @@index([sucursalId])
}

model Subcategoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  categoriaId Int
  descuentos  Json?
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  productos   Producto[]

  @@unique([nombre, categoriaId])
  @@index([categoriaId])
}

model ShareLink {
  id           Int           @id @default(autoincrement())
  codeHash     String        @unique
  type         ShareLinkType
  targetId     Int
  expiresAt    DateTime
  maxViews     Int           @default(3)
  views        Int           @default(0)
  createdAt    DateTime      @default(now())
  lastViewedAt DateTime?
  codeEnc      String
  rangeStart   DateTime?
  rangeEnd     DateTime?

  @@index([type, targetId, expiresAt])
}

model CatalogVisit {
  id          Int      @id @default(autoincrement())
  sucursalId  Int
  visitorHash String
  bucketStart DateTime
  visitedAt   DateTime @default(now())
  source      String   @default("public_lista")
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([sucursalId, visitorHash, bucketStart])
  @@index([sucursalId, visitedAt])
}

model Consignacion {
  id                Int                   @id @default(autoincrement())
  clienteId         Int
  fecha             DateTime              @default(now())
  estado            EstadoConsignacion    @default(ABIERTA)
  /// Folio secuencial por cliente (ej: Pedro #1, Pedro #2)
  numeroFolio       Int
  porcentajeAumento Float                 @default(0)
  sucursalId        Int                   @default(1)
  cliente           Cliente               @relation(fields: [clienteId], references: [id])
  sucursal          Sucursal              @relation(fields: [sucursalId], references: [id])
  detalles          ConsignacionDetalle[]
  liquidaciones     Liquidacion[]

  @@index([clienteId, fecha])
  @@index([estado, fecha])
  @@index([clienteId, numeroFolio])
  @@index([sucursalId])
}

model ConsignacionDetalle {
  id                 Int               @id @default(autoincrement())
  consignacionId     Int
  productoId         Int
  /// TODO EN UNITS
  unitsEntregadas    Int
  unitsVendidasAcum  Int               @default(0)
  unitsDevueltasAcum Int               @default(0)
  precioUnitario     Decimal           @default(0) @db.Decimal(10, 2)
  descuento          Decimal           @default(0) @db.Decimal(10, 2)
  consignacion       Consignacion      @relation(fields: [consignacionId], references: [id], onDelete: Cascade)
  producto           Producto          @relation(fields: [productoId], references: [id])
  liquidacionItems   LiquidacionItem[]

  @@index([consignacionId])
  @@index([productoId])
}

model Liquidacion {
  id             Int               @id @default(autoincrement())
  consignacionId Int
  fecha          DateTime          @default(now())
  consignacion   Consignacion      @relation(fields: [consignacionId], references: [id], onDelete: Cascade)
  items          LiquidacionItem[]
  venta          Venta?

  @@index([consignacionId, fecha])
}

model LiquidacionItem {
  id                    Int                 @id @default(autoincrement())
  liquidacionId         Int
  consignacionDetalleId Int
  /// TODO EN UNITS
  unitsVendidas         Int                 @default(0)
  unitsDevueltas        Int                 @default(0)
  /// snapshot del precio al liquidar
  precioUnitario        Decimal             @db.Decimal(10, 2)
  descuento             Decimal             @default(0) @db.Decimal(10, 2)
  detalle               ConsignacionDetalle @relation(fields: [consignacionDetalleId], references: [id])
  liquidacion           Liquidacion         @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([liquidacionId])
  @@index([consignacionDetalleId])
}

model CheckoutIntent {
  id                String                 @id @default(cuid())
  cliente           Json
  items             Json
  envio             Json?
  totals            Json
  status            CheckoutIntentStatus   @default(INITIATED)
  paymentProvider   CheckoutIntentProvider @default(MERCADOPAGO)
  externalReference String                 @unique
  mpPreferenceId    String?
  mpPaymentId       String?                @unique
  mpMerchantOrderId String?
  failureReason     String?
  processedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  ventaId           Int?                   @unique
  venta             Venta?                 @relation(fields: [ventaId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model Venta {
  id              Int             @id @default(autoincrement())
  clienteId       Int
  liquidacionId   Int?            @unique
  fecha           DateTime        @default(now())
  total           Decimal         @db.Decimal(10, 2)
  descuentoGlobal Decimal         @default(0) @db.Decimal(10, 2)
  sesionCajaId    Int?
  tipo            TipoVenta       @default(CASUAL)
  metodoPago      MetodoPago      @default(EFECTIVO)
  sucursalId      Int             @default(1)
  numeroVenta     Int?
  cliente         Cliente         @relation(fields: [clienteId], references: [id])
  liquidacion     Liquidacion?    @relation(fields: [liquidacionId], references: [id])
  sesionCaja      SesionCaja?     @relation(fields: [sesionCajaId], references: [id], onDelete: Restrict)
  sucursal        Sucursal        @relation(fields: [sucursalId], references: [id])
  detalles        VentaDetalle[]
  envio           Envio?
  checkoutIntent  CheckoutIntent?

  // Anulación
  anulada         Boolean   @default(false)
  motivoAnulacion String?
  fechaAnulacion  DateTime?

  @@index([clienteId, fecha])
  @@index([sesionCajaId])
  @@index([tipo])
  @@index([sucursalId])
}

model Envio {
  id                Int      @id @default(autoincrement())
  ventaId           Int      @unique
  estado            String   @default("PENDIENTE") // PENDIENTE, ENVIADO, ENTREGADO, CANCELADO
  codigoSeguimiento String?
  costo             Decimal  @default(0) @db.Decimal(10, 2)
  metodoEnvio       String // DOMICILIO, SUCURSAL
  direccionEnvio    Json // Guardamos un snapshot de donde se manda (calle, numero, cp, provincia, depto...)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
}

model VentaDetalle {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  /// TODO EN UNITS
  units          Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  descuento      Decimal  @default(0) @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  producto       Producto @relation(fields: [productoId], references: [id])
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  // Estado del item al anular
  esRotura Boolean @default(false)

  @@index([ventaId])
  @@index([productoId])
}

model Pago {
  id           Int         @id @default(autoincrement())
  clienteId    Int
  sucursalId   Int         @default(1)
  tipo         String      @default("VENTA") // VENTA, DEUDA
  fecha        DateTime    @default(now())
  monto        Decimal     @db.Decimal(10, 2)
  metodo       MetodoPago
  sesionCajaId Int?
  cliente      Cliente     @relation(fields: [clienteId], references: [id])
  sucursal     Sucursal    @relation(fields: [sucursalId], references: [id])
  sesionCaja   SesionCaja? @relation(fields: [sesionCajaId], references: [id], onDelete: Restrict)

  @@index([clienteId, fecha])
  @@index([sesionCajaId])
  @@index([sucursalId])
  @@index([tipo])
}

model Plan {
  id            Int            @id @default(autoincrement())
  nombre        String
  descripcion   String?
  precioARS     Decimal        @db.Decimal(10, 2)
  precioUSD     Decimal        @db.Decimal(10, 2)
  mercadopagoId String?
  paypalId      String?
  activo        Boolean        @default(true)
  limits        PlanLimit?
  promoCodes    PromoCode[]
  subscriptions Subscription[]
}

model Subscription {
  id                String               @id @default(cuid())
  userId            Int                  @unique
  planId            Int
  status            EstadoSuscripcion    @default(PRUEBA)
  provider          ProveedorSuscripcion
  externalId        String               @unique
  mpPreapprovalId   String?
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  plan              Plan                 @relation(fields: [planId], references: [id])
  user              Usuario              @relation(fields: [userId], references: [id])
}

model PlanLimit {
  id                  Int      @id @default(autoincrement())
  planId              Int      @unique
  maxProductos        Int      @default(-1)
  maxUsuarios         Int      @default(5)
  maxFacturasOcr      Int      @default(0)
  allowConsignaciones Boolean  @default(false)
  allowSucursales     Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  plan                Plan     @relation(fields: [planId], references: [id])
}

model PromoCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  planId       Int
  durationDays Int
  maxUses      Int       @default(1)
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  plan         Plan      @relation(fields: [planId], references: [id])
}

model ResetPasswordToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Sucursal {
  id                        Int                @id @default(autoincrement())
  nombre                    String
  esPrincipal               Boolean            @default(false)
  activa                    Boolean            @default(true)
  // Si es false, esta sucursal se excluye de la vista "Todas las Sucursales" del dashboard
  // (KPIs, tendencia, top productos/consignados, stock y gastos). No afecta su vista individual.
  incluidaEnDashboardGlobal Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  branding                  Branding?
  cajas                     Caja[]
  clientes                  Cliente[]
  configuracion             Configuracion?
  consignaciones            Consignacion[]
  movimientos               MovimientoStock[]
  notifications             Notification[]
  productos                 Producto[]
  stockProductos            StockSucursal[]
  usuarios                  Usuario[]
  ventas                    Venta[]
  gastos                    Gasto[]
  categoriasGasto           CategoriaGasto[]
  categorias                Categoria[]
  pagos                     Pago[]
  gastosCompartidos         GastoSucursal[]
  pedidosEsperados          PedidoEsperado[]
  catalogVisits             CatalogVisit[]
  storeSettings             StoreSettings?
  facturasProveedor         FacturaProveedor[]
  proveedores               Proveedor[]
}

model StoreSettings {
  id                Int      @id @default(autoincrement())
  sucursalId        Int      @unique
  themeConfig       Json
  onlineStoreConfig Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
}

model StockSucursal {
  id                   Int      @id @default(autoincrement())
  productoId           Int
  sucursalId           Int
  stockDisponibleUnits Int      @default(0)
  stockConsignadoUnits Int      @default(0)
  stockMinUnits        Int      @default(0)
  precioVentaOverride  Decimal? @db.Decimal(10, 2)
  precioCostoOverride  Decimal? @db.Decimal(10, 2)
  producto             Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sucursal             Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([productoId, sucursalId])
}

model Gasto {
  id                    Int             @id @default(autoincrement())
  monto                 Decimal         @db.Decimal(10, 2)
  fecha                 DateTime        @default(now())
  fechaVencimiento      DateTime?
  motivo                String
  estado                EstadoGasto     @default(PAGADO)
  esRecurrente          Boolean         @default(false)
  frecuencia            FrecuenciaGasto @default(UNICO)
  categoriaGastoId      Int
  sucursalId            Int             @default(1)
  userId                Int?
  comprobanteUrl        String?
  cuotaActual           Int?
  cuotaTotal            Int?
  recurrenciaId         String?
  esCompartido          Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  categoria             CategoriaGasto  @relation(fields: [categoriaGastoId], references: [id])
  sucursal              Sucursal        @relation(fields: [sucursalId], references: [id])
  user                  Usuario?        @relation(fields: [userId], references: [id])
  sucursalesCompartidas GastoSucursal[]

  @@index([sucursalId])
  @@index([categoriaGastoId])
  @@index([fecha])
  @@index([estado])
  @@index([recurrenciaId])
}

model GastoSucursal {
  id                Int      @id @default(autoincrement())
  gastoId           Int
  sucursalId        Int
  montoProporcional Decimal  @db.Decimal(10, 2)
  gasto             Gasto    @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  sucursal          Sucursal @relation(fields: [sucursalId], references: [id])

  @@unique([gastoId, sucursalId])
  @@index([sucursalId])
  @@index([gastoId])
}

model CategoriaGasto {
  id         Int      @id @default(autoincrement())
  nombre     String
  sucursalId Int      @default(1)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  gastos     Gasto[]

  @@unique([nombre, sucursalId])
  @@index([sucursalId])
}

enum EstadoGasto {
  PENDIENTE
  PAGADO
}

// ═══════════════════════════════════════════════════════════════════
// OCR de facturas de proveedores
// ═══════════════════════════════════════════════════════════════════

model Proveedor {
  id              Int      @id @default(autoincrement())
  nombre          String
  cuit            String?
  monedaPreferida String   @default("ARS")
  activo          Boolean  @default(true)
  sucursalId      Int?     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sucursal Sucursal?                @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  facturas FacturaProveedor[]
  alias    ProductoProveedorAlias[]

  @@index([activo])
  @@index([nombre])
  @@index([sucursalId])
}

model FacturaProveedor {
  id                       Int                    @id @default(autoincrement())
  proveedorId              Int?
  sucursalId               Int
  archivoPath              String
  archivoMime              String
  /// El binario original se borra del disco al confirmar/cancelar la factura para
  /// ahorrar espacio: los datos estructurados (items) ya quedan persistidos.
  archivoEliminado         Boolean                @default(false)
  numeroFactura            String?
  fecha                    DateTime?
  moneda                   String                 @default("ARS")
  totalDetectado           Decimal?               @db.Decimal(12, 2)
  ocrTextoCompleto         String?
  estado                   EstadoFacturaProveedor @default(PENDIENTE)
  confianzaOcr             Float?
  errorMensaje             String?
  proveedorNombreDetectado String?
  proveedorCuitDetectado   String?
  iaRespuestaCruda         Json?
  iaModeloUsado            String?
  iaTokensUsados           Int?
  // Rubro de Configuracion.rubroNegocio copiado (no referenciado) al momento de
  // procesar esta factura — Configuracion.rubroNegocio es mutable, así que una
  // copia evita que facturas viejas cambien de categoría si el rubro del negocio
  // cambia después. Se usa para agrupar métricas de precisión/consumo por rubro.
  rubroNegocio             String?
  // Snapshot de los campos de cabecera tal como los propuso la IA, tomado una
  // sola vez al crear la factura (ver process/route.ts) y nunca vuelto a tocar
  // por PATCH /[id] — así el diff contra el campo vivo (que sí lo edita el
  // usuario) mide corrección humana real. Shape: FacturaValoresIaOriginal
  // (src/lib/validators/factura-proveedor.ts).
  valoresIaOriginal        Json?
  creadoPor                Int
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  proveedor Proveedor?             @relation(fields: [proveedorId], references: [id])
  sucursal  Sucursal               @relation(fields: [sucursalId], references: [id])
  items     FacturaProveedorItem[]

  @@index([sucursalId])
  @@index([proveedorId])
  @@index([estado])
}

model FacturaProveedorItem {
  id                          Int               @id @default(autoincrement())
  facturaId                   Int
  productoId                  Int?
  textoOriginal               String
  descripcionNormalizada      String?
  codigoProveedor             String?
  cantidad                    Int
  precioUnitario              Decimal?          @db.Decimal(12, 4)
  totalLinea                  Decimal?          @db.Decimal(12, 2)
  confianzaExtraccion         Float?
  matchScore                  Float?
  matchMotivo                 String?
  estado                      EstadoItemFactura @default(PENDIENTE)
  // Sugerencia de catalogo-global-api cuando no hubo match local (productoId
  // null tras matchearItem()) — puramente informativa hasta que el usuario
  // confirma o crea el producto; ver openspec/changes/catalogo-global-api.
  // Se persiste acá (y no solo en memoria) porque la revisión del usuario
  // puede ocurrir mucho después de procesar la factura.
  candidatoGlobalId           String?
  candidatoGlobalNombre       String?
  candidatoGlobalCodigoBarras String?
  candidatoGlobalScore        Float?
  // Columnas detectadas por la IA que no matchean ningún campo estándar (lote,
  // vencimiento, talle, color, etc. según el rubro) — pares clave-valor libres.
  atributosExtra              Json?
  // Advertencias de la validación aritmética post-extracción (unitCost*cantidad
  // vs totalLinea, o suma de líneas vs total de factura) — ver
  // src/lib/ai/validar-consistencia-factura.ts. Informativas: nunca bloquean la
  // confirmación manual del item.
  advertencias                String[]          @default([])
  // Snapshot de textoOriginal/codigoProveedor/cantidad/precioUnitario/totalLinea
  // tal como los propuso la IA, tomado una sola vez al crear el item (ver
  // process/route.ts) y nunca vuelto a tocar por PATCH /items/[id] — así el
  // diff contra el campo vivo mide corrección humana real, no lectura de la IA.
  // Shape: FacturaItemValoresIaOriginal (src/lib/validators/factura-proveedor-item.ts).
  valoresIaOriginal           Json?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  factura  FacturaProveedor @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto Producto?        @relation(fields: [productoId], references: [id])

  @@index([facturaId])
  @@index([productoId])
  @@index([estado])
}

model ProductoProveedorAlias {
  id               Int      @id @default(autoincrement())
  proveedorId      Int
  productoId       Int
  codigoProveedor  String?
  textoNormalizado String?
  usoCount         Int      @default(1)
  confianza        Float    @default(1.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Id del ProductoGlobal (catalogo-global-api) del que se originó este alias,
  // cuando el item confirmado venía de una sugerencia de catálogo global —
  // solo trazabilidad, nunca se resuelve consultando la API central de nuevo.
  productoGlobalId String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  producto  Producto  @relation(fields: [productoId], references: [id])

  @@unique([proveedorId, codigoProveedor])
  @@index([proveedorId, textoNormalizado])
  @@index([productoId])
}

model HistorialCostoProducto {
  id            Int      @id @default(autoincrement())
  productoId    Int
  proveedorId   Int?
  facturaItemId Int?     @unique
  costoAnterior Decimal? @db.Decimal(12, 4)
  costoNuevo    Decimal  @db.Decimal(12, 4)
  moneda        String   @default("ARS")
  variacionPct  Float?
  createdAt     DateTime @default(now())

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, createdAt])
}

