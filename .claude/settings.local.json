      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/.npmrc)",
      "Read(//c/Users/Administrator/.ssh/**)",
      "Read(//c/Users/Administrator/.aws/**)",
      "Read(//c/Users/Administrator/.claude/.credentials.json)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push --force-reset *)",
      "Bash(npx prisma db push --accept-data-loss *)",
